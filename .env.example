# Local SQLite (default). Production on Vercel: Neon Postgres.
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Never seed on Vercel — vercel-build runs generate + migrate deploy only.
DATABASE_URL="file:./prisma/dev.db"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional — Bearer secret for POST /api/clerk/webhook (user.created / user.updated).
CLERK_WEBHOOK_SECRET=

# Public site URL (Stripe redirects, absolute share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Pro subscription (merchant billing). Webhook: /api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — HMAC secret for signed attribution receipts (defaults to CLERK_SECRET_KEY).
ATTRIBUTION_SIGNING_SECRET=

# Optional — AI for store copy + product URL import fallback (gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meta / WhatsApp Cloud API (Embedded Signup v4 — see docs/META_CONNECT.md)
# Create a Business-type Meta App, add WhatsApp, configure Facebook Login for Business
# Embedded Signup with Cloud API, then App Review for Advanced Access in production.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
# 32+ char secret used to AES-GCM encrypt merchant WhatsApp access tokens at rest.
META_TOKEN_ENCRYPTION_KEY=
# Optional Graph API version (default v21.0)
META_GRAPH_VERSION=v21.0
# Wave C — set true to simulate Marketing API launches without Graph create calls
META_ADS_DRY_RUN=false
# Wave 2 — simulate CTWA CAPI (LeadSubmitted / Purchase) without Graph writes
META_CAPI_DRY_RUN=false
# Authorize GET/POST /api/cron/meta-recovery (Bearer token). Loopback allowed if unset.
# Same value as GitHub secret CRON_SECRET if using .github/workflows/meta-recovery.yml
CRON_SECRET=

# General manager. Either your Clerk user id, or the email you sign in with.
ADMIN_CLERK_USER_IDS=
ADMIN_EMAILS=

# Optional. If set, new contact leads are emailed as well as stored.
RESEND_API_KEY=
RESEND_FROM=

# Local only. Never set on Vercel. Requires NODE_ENV=development as well.
ALLOW_DEV_IMPERSONATION=

# Interactive demo on localhost — lets anyone try merchant/buyer personas without Clerk.
# Set both for the full experience (server auth bypass + hero CTA).
ALLOW_DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
