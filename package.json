{
  "name": "ogp-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --skip-seed --force && tsx prisma/seed.ts",
    "smoke:onboarding": "node scripts/smoke-onboarding.mjs",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.mjs",
    "coach:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-coach.ps1",
    "coach:vision": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-vision.ps1",
    "coach:export": "tsx scripts/export-coach-dataset.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@google/genai": "^2.19.0",
    "@prisma/client": "^5.22.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.469.0",
    "next": "14.2.35",
    "next-intl": "^3.26.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.40",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  }
}
